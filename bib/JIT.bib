@article{HeegerHermelinItzhakiSchieberShabtay:26:Just-in-Time-Scheduling-in-Two-Stage-Flexible-Flow-Shops,
    author = {Heeger, Klaus and Hermelin, Danny and Itzhaki, Yuval and Schieber, Baruch and Shabtay, Dvir},
    title = {Just-in-Time Scheduling in Two-Stage Flexible Flow Shops},
    journal = {European Journal of Operational Research},
    year = {2026},
    doi = {10.1016/j.ejor.2026.02.017},
    Annote = {$FF(1,m)||\sum Z_j$ is strongly NP-hard\\
              $FF(1,m)||\sum Z_j [m]$ is strongly W[2]-hard\\
              $FF(1,m)||\sum w_jZ_j [m]$ is solvable in time $O(W\cdot n^m)$, where $W$ is the total weight of the jobs\\
              $FF(1,m)||\sum w_jZ_j [q_{\max}]$ is solvable in time $O(W\cdot m^{q_{\max}}\cdot n)$, where $W$ is the total weight of the jobs\\
              $FF(1,m)||\sum w_jZ_j [\chi]$ is solvable in time $O(W\cdot 2^{\chi}\cdot n)$, where $W$ is the total weight of the jobs\\
              $FF(1,m)|p_j=p|\sum Z_j$ is in $P$\\
              $FF(1,m)||\sum w_jZ_j$ has an FPTAS when the number of second-stage machines is constant, when the maximum second-stage processing time is constant, or when the chromatic number of the second-stage conflict graph is logarithmic in the number of jobs}
}

